# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work

.idea

.vscode

# custom
raw_resources/
/scripts
# local simulation helper scripts (keep only the documented ones)
tools/*
!tools/sim-ci.sh
!tools/sim-periodic.sh
!tools/perf-gate.sh
!tools/sim-suite.sh
bin/

ideas.md

.env
.claude
.codebuddy
.gemini
.specify
.venv
specs
openspec

jutland
jutland.log
/jutland-sim
/jutland-duel
/jutland-macro

.DS_Store

# 本地计划文档
plans/

# 本地模拟/平衡报告（生成物、体积大，不提交）
/reports/

# 本地模拟实验数据（场景/golden/基线），推荐放私有仓库并用 JUTLAND_SIM_HOME 指向
/sim/
