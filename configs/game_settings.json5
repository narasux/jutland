// 游戏设置配置文件
// SpeedMultiplier: 全局速度倍率（慢=0.50 / 标准=1.00 / 快=2.00），影响战舰、炮弹、鱼雷、飞机等移动/转向速度
// 范围: 0.50 ~ 2.00，默认值: 1.00

// Language: 游戏界面语言，当前正式启用 zh-Hans / zh-Hant / en / ru / ja
// bgmVolume: 背景音乐音量 0.00 ~ 1.00，0 为静音，默认 1.00
// effectsVolume: 战场音效（火炮 / 鱼雷 / 爆炸等）音量 0.00 ~ 1.00，默认 1.00
// EnableLandAirfield: 陆地机场功能总开关，false 时所有任务不生成机场
// aiStrategies: 电脑可用策略，attack/defend/counter/raid/scout 为 false 时对局中不使用
// EnableFogOfWar: 战争迷雾总开关，默认关闭；关闭时不计算迷雾
// EnablePenetration: 实验性穿甲伤害开关，默认关闭；开启后按弹药穿深/舰体装甲缩放伤害
// EnableRamming: 撞击伤害开关，默认关闭；只影响普通战舰，水滴/巨大剑鱼始终开启
// EnableShipCollision: 舰体碰撞检查开关，默认开启；开启后不同阵营舰船不再重叠，友军仍可穿行
// EnableMinimap: 小地图总开关，默认开启；开启时开局自动展开战术面板显示小地图
// DisplayHitEffects: 命中特效总开关，默认开启；关闭后命中舰体 / 落水 / 落陆不再生成特效
// DisplayDamageNumber: 是否显示命中伤害数字，默认开启
// ForceDisplayState: 是否常显战舰状态（HP / 武器装填），默认开启；关闭后仅选中时显示
// wakeTrail: 战舰水面尾流参数，length 航迹长度 0.40~2.50、width 宽度 0.40~2.00、opacity 浓度 0.20~1.50，默认均为 1.00

{
  "speedMultiplier": 1,
  "language": "zh-Hans",
  "bgmVolume": 1,
  "effectsVolume": 1,
  "aiStrategies": {
    "attack": true,
    "defend": true,
    "counter": true,
    "raid": true,
    "scout": true
  },
  "enableLandAirfield": true,
  "enableFogOfWar": false,
  "enablePenetration": false,
  "enableRamming": true,
  "enableShipCollision": true,
  "enableMinimap": true,
  "displayHitEffects": true,
  "displayDamageNumber": true,
  "forceDisplayState": true,
  "wakeTrail": {
    "length": 1,
    "width": 1,
    "opacity": 1
  },
  "tutorialCompleted": []
}