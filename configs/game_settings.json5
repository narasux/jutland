// 游戏设置配置文件
// SpeedMultiplier: 全局速度倍率（慢=0.50 / 标准=1.00 / 快=2.00），影响战舰、炮弹、鱼雷、飞机等移动/转向速度
// 范围: 0.50 ~ 2.00，默认值: 1.00

// Language: 游戏界面语言，当前正式启用 zh-Hans / en / ru / ja
// EnableLandAirfield: 陆地机场功能总开关，false 时所有任务不生成机场
// aiStrategies: 电脑可用策略，attack/defend/counter/raid/scout 为 false 时对局中不使用
// EnableFogOfWar: 战争迷雾总开关，默认关闭；关闭时不计算迷雾

{
  "speedMultiplier": 1,
  "language": "zh-Hans",
  "enableLandAirfield": true,
  "aiStrategies": {
    "attack": true,
    "defend": true,
    "counter": true,
    "raid": true,
    "scout": true
  },
  "enableFogOfWar": true
}