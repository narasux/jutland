  {
    name: "hosho",
    displayName: "Hōshō",
    type: "Light Aircraft Carrier",
    armaments: [
      {
        label: "Main Battery",
        value: "4x1 140mm/50 3rd Year Type",
      },
      {
        label: "Anti-aircraft Guns",
        value: "6x3 25mm/60 Type 96",
