  {
    name: "VB10",
    displayName: "VB.10",
    type: "Twin-Engine Heavy Interceptor",
    armaments: [
      {
        label: "Cannon (Fixed Forward, Nose)",
        value: "4 x 20mm HS.404",
      },
    ],
    description: "The Arsenal VB.10 was a French twin-engined heavy interceptor developed at the end of World War II, first flying on 7 July 1945. Two 1,150 hp Hispano-Suiza 12Zars engines were mounted in tandem inside the fuselage and drove a coaxial six-blade contra-rotating propeller, giving a maximum speed of about 700 km/h and a range of about 1,700 km. The production version carried four 20mm HS.404 cannon. Although 200 aircraft were ordered, the maturing jet fighter made the design obsolete and the order was cancelled in 1948 after six aircraft had been built. In game it is represented as a heavily armed high-speed fighter.",
    author: "Unknown",
    links: [
      {
        name: "Wikipedia - Arsenal VB 10",
        url: "https://en.wikipedia.org/wiki/Arsenal_VB_10",
      },
    ],
  },
