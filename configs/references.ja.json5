  {
    name: "hood",
    displayName: "フッド",
    type: "巡洋戦艦",
    armaments: [
      {
        label: "主砲",
        value: "4x2 381mm/42",
      },
      {
        label: "副砲",
        value: "16x1 140mm/50",
